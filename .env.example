# Thanos Configuration
THANOS_URL=https://rbac-query-proxy.open-cluster-management-observability.svc.cluster.local
THANOS_TOKEN=
THANOS_TLS_VERIFY=true
THANOS_CA_FILE=

# Cache Configuration
CACHE_TTL=30
REFRESH_INTERVAL=30

# CPU Thresholds (%)
CPU_WARNING=70
CPU_HIGH=85
CPU_CRITICAL=90

# Memory Thresholds (%)
MEMORY_WARNING=75
MEMORY_HIGH=85
MEMORY_CRITICAL=90

# Time Windows
HIGH_CPU_WINDOW=5m
HIGH_MEMORY_WINDOW=5m
METRICS_STALE_THRESHOLD=5m

# Alerting
ALERT_IGNORE_LIST=Watchdog,InfoInhibitor

# Development
MOCK_MODE=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
